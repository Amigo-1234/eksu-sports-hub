# ─────────────────────────────────────────────────────────────────────────────
# EKSU Sports Hub — environment variables. Copy to .env.local (git-ignored).
# Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Operator console backend (required for /op in production) ──────────────
# "supabase" = real authenticated backend. "mock" = in-browser demo only.
# Unset: development uses mock; production shows "Operator console
# unavailable" (there is no silent fallback to mock).
NEXT_PUBLIC_OPERATOR_BACKEND=supabase

# Supabase project (Project Settings → API). Local values come from
# `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key — safe in the browser; all access is enforced by RLS/RPCs.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── SERVER-ONLY secret — never prefix with NEXT_PUBLIC_, never commit ───────
# Secret (service_role) key. Read by the Next.js server ONLY in server-only
# modules: src/lib/admin/authAdmin.ts (staff invite/password-reset links,
# blocking deactivated staff) and src/lib/registration/server.ts (registration
# intake and, through it, match-alert device settings + dispatch). Also used by
# `npm run dev:users` and `npm run test:backend`. Without it the admin
# dashboard works, but "Add staff member" is disabled.
# On Vercel: add as a normal (server) env var, type Sensitive.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: canonical site origin for one-time invite links, e.g.
# https://eksu-sports-hub.vercel.app. Default: the request's host.
# NEXT_PUBLIC_SITE_URL=
# Password given to the development operator accounts by `npm run dev:users`.
DEV_USER_PASSWORD=choose-a-long-dev-password

# ── Public data source ──────────────────────────────────────────────────────
# supabase (default whenever NEXT_PUBLIC_SUPABASE_* are set) | mock (dev/testing
# only — refused on a Vercel production deployment).
# PUBLIC_DATA_SOURCE=supabase

# ── Demo data options (only used when PUBLIC_DATA_SOURCE=mock) ───────────────
# default | no-live | empty | error
MOCK_SCENARIO=default
# Artificial latency for every public match query, to preview skeletons.
MOCK_LATENCY_MS=0

# ── Match alerts (Web Push) — default OFF ───────────────────────────────────
# Turn on only after the notifications migration, pg_net/pg_cron and the
# dispatcher secret are set up (see docs/BACKEND.md → Match alerts).
# PUSH_NOTIFICATIONS_ENABLED=true
# The VAPID key pair is NOT an env var: it is generated server-side and kept
# in Supabase Vault (see docs/BACKEND.md → VAPID keys).
# Contact for push services (mailto: or https:):
# VAPID_SUBJECT=mailto:sports@example.edu.ng
# SERVER-ONLY shared secret (≥ 32 chars) that Postgres (pg_net/pg_cron) sends
# as `Authorization: Bearer …` to POST /api/notifications/dispatch. Store the
# same value in Supabase Vault as `notifications_dispatch_secret`.
# NOTIFICATIONS_DISPATCH_SECRET=
