# ─────────────────────────────────────────────────────────────────────────────
# EKSU Sports Hub — environment variables. Copy to .env.local (git-ignored).
# Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Operator console backend (required for /op in production) ──────────────
# "supabase" = real authenticated backend. "mock" = in-browser demo only.
# Unset: development uses mock; production shows "Operator console
# unavailable" (there is no silent fallback to mock).
NEXT_PUBLIC_OPERATOR_BACKEND=supabase

# Supabase project (Project Settings → API). Local values come from
# `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key — safe in the browser; all access is enforced by RLS/RPCs.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Server-side scripts/tests only — NEVER expose to the browser or Vercel ───
# Secret (service_role) key. Used only by `npm run dev:users` and
# `npm run test:backend`. The Next.js app does not read it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Password given to the development operator accounts by `npm run dev:users`.
DEV_USER_PASSWORD=choose-a-long-dev-password

# ── Public site demo data (public pages still use mock data this phase) ─────
# default | no-live | empty | error
MOCK_SCENARIO=default
# Artificial latency for every public match query, to preview skeletons.
MOCK_LATENCY_MS=0
